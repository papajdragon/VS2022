<Window x:Class="SumApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="합계 계산기" Height="400" Width="460"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#F1F3F4" FontFamily="Google Sans, Segoe UI, Malgun Gothic">

    <Window.Resources>
        <SolidColorBrush x:Key="GoogleBlue" Color="#1A73E8" />
        <SolidColorBrush x:Key="GoogleBlueHover" Color="#1765CC" />
        <SolidColorBrush x:Key="GoogleBluePressed" Color="#185ABC" />
        <SolidColorBrush x:Key="Outline" Color="#DADCE0" />
        <SolidColorBrush x:Key="TextPrimary" Color="#202124" />
        <SolidColorBrush x:Key="TextSecondary" Color="#5F6368" />

        <!-- 구글 스타일 외곽선 입력창 -->
        <Style x:Key="GoogleTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource GoogleBlue}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="box" Background="White" CornerRadius="4"
                                    BorderBrush="{StaticResource Outline}" BorderThickness="1" Height="56">
                                <Grid>
                                    <TextBlock x:Name="hint" Text="끝 수" Margin="16,0,0,0"
                                               VerticalAlignment="Center" FontSize="16"
                                               Foreground="{StaticResource TextSecondary}"
                                               IsHitTestVisible="False" Visibility="Collapsed" />
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="16,0" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="hint" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#202124" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource GoogleBlue}" />
                                <Setter TargetName="box" Property="BorderThickness" Value="2" />
                                <Setter TargetName="hint" Property="Foreground" Value="{StaticResource GoogleBlue}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 구글 스타일 채워진 버튼 -->
        <Style x:Key="GoogleButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource GoogleBlue}" CornerRadius="20"
                                Height="40" Padding="24,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource GoogleBlueHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource GoogleBluePressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <!-- 카드 -->
        <Border Background="White" CornerRadius="12" Padding="32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.18" />
            </Border.Effect>

            <StackPanel>
                <!-- 구글 느낌의 컬러 타이틀 -->
                <TextBlock FontSize="28" HorizontalAlignment="Center">
                    <Run Text="합" Foreground="#4285F4" /><Run Text="계" Foreground="#EA4335" /><Run Text=" " /><Run Text="계" Foreground="#FBBC05" /><Run Text="산" Foreground="#34A853" /><Run Text="기" Foreground="#EA4335" />
                </TextBlock>
                <TextBlock Text="1부터 끝 수까지 더해 드려요" FontSize="14" Margin="0,6,0,28"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" />

                <TextBox x:Name="txtEnd" Style="{StaticResource GoogleTextBox}" KeyDown="TxtEnd_KeyDown" />

                <Button x:Name="btnCalc" Content="계산" Style="{StaticResource GoogleButton}"
                        Margin="0,20,0,0" HorizontalAlignment="Stretch" IsDefault="True" Click="BtnCalc_Click" />

                <!-- 결과 칩 -->
                <Border x:Name="resultBox" Margin="0,24,0,0" CornerRadius="8" Padding="16,14"
                        Background="#E8F0FE" Visibility="Collapsed">
                    <TextBlock x:Name="lblResult" FontSize="20" FontWeight="Medium"
                               Foreground="#1967D2" TextWrapping="Wrap" HorizontalAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
